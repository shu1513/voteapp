 {
  "session": 2170,
  "bill": "HB1239",
  "type": "B",
  "title": "Revise certain provisions related to the restriction of access to obscene materials in a public library or public school library.",
  "slots": [
   {
    "chamber": "H",
    "roll": 1514929,
    "date": "2025-03-11",
    "tally": "36-34",
    "desc": "Concurred in amendments"
   }
  ],
  "disposition": "dropped",
  "reason": "Hoghouse amendment. The Senate replaced the whole bill: it started as a repeal of the legal defense that protects school and library staff from obscenity charges, and what passed only requires schools and libraries to let a person appeal to the board over whether material is obscene, with court review. On that enacted text neither direction is honest, so it fails the fifth filter."
 },
 {
