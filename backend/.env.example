DATABASE_URL=postgresql://localhost:5432/voteapp
REDIS_URL=redis://localhost:6379
AI_PROVIDER=openai
AI_MODEL=gpt-5.4-mini
AI_TIMEOUT_MS=90000
ANTHROPIC_WEB_SEARCH_MAX_USES=3
PROMPT_VERSION=state_resources_v2
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
CENSUS_API_KEY_1=
CENSUS_API_KEY_2=
CENSUS_API_KEY_3=
OBS_SPIKE_MIN_EVENTS=20
OBS_REJECT_SPIKE_RATE=0.25
OBS_RETRY_SPIKE_RATE=0.25
OBS_FAILED_SPIKE_RATE=0.25
OBS_REASON_SPIKE_COUNT=10
STATE_RESOURCES_SCHEDULER_QUEUE=state_resources_maintenance
STATE_RESOURCES_MONTHLY_CRON="0 3 1 * *"
STATE_RESOURCES_MONTHLY_TZ=UTC
STATE_RESOURCES_SCHEDULER_MAX_PASSES=3
STATE_RESOURCES_SCHEDULER_BATCH_SIZE=200
STATE_RESOURCES_SCHEDULER_BLOCK_MS=250

# Address API
ADDRESS_API_HOST=127.0.0.1
ADDRESS_API_PORT=3001
ADDRESS_API_ALLOWED_ORIGINS=http://localhost:3000
ADDRESS_API_RATE_LIMIT_ENABLED=true
ADDRESS_API_RATE_LIMIT_WINDOW_MS=60000
ADDRESS_API_RATE_LIMIT_MAX_REQUESTS=60
ADDRESS_API_RATE_LIMIT_MAX_BUCKETS=10000
# Optional proxy-aware rate limit keying.
# SECURITY: Only set this when a trusted proxy injects the header and strips any
# client-supplied copy. If unset, rate limiting uses the direct socket IP.
# Common trusted-proxy values: X-Forwarded-For, CF-Connecting-IP, Fly-Client-IP.
# ADDRESS_API_TRUSTED_CLIENT_IP_HEADER=X-Forwarded-For
ADDRESS_LOOKUP_CACHE_ENABLED=true
ADDRESS_LOOKUP_CACHE_TTL_SECONDS=1209600
CENSUS_ADDRESS_GEOCODER_BENCHMARK=Public_AR_Current
CENSUS_ADDRESS_GEOCODER_VINTAGE=ACS2024_Current
CENSUS_ADDRESS_GEOCODER_LAYERS=all
CENSUS_ADDRESS_GEOCODER_TIMEOUT_MS=10000
