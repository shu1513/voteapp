{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ],
      // Pin the workspace package to THIS checkout's source (same as the
      // frontend tsconfig and vitest alias): node resolution walks up to the
      // repo root's node_modules, which in a git worktree symlinks to the
      // MAIN checkout's packages/ — typecheck would silently read the wrong
      // sources.
      "@voteapp/api-client": [
        "../packages/api-client/src/index.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ]
}