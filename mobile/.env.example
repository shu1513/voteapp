# Copy to .env for local development. EXPO_PUBLIC_* values are inlined into
# the JS bundle at build time — never put secrets here.

# API origin. Dev simulator uses the local backend; release builds must set
# this (the app refuses to boot without it) — configure it in the EAS build
# profile for store builds.
EXPO_PUBLIC_API_URL=http://127.0.0.1:3001

# Optional. Per-request timeout override; defaults to 75000 while the
# production API runs on Render's free tier (~1 minute cold start).
# EXPO_PUBLIC_API_TIMEOUT_MS=75000

# Optional. Sentry project for the mobile app (separate from web). Error
# monitoring stays off when unset.
# EXPO_PUBLIC_SENTRY_DSN=
# EXPO_PUBLIC_DEPLOY_ENV=development
