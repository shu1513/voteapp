node_modules/

# Ohio SoS campaign-finance artifact cache: ~305 MB of bulk CSVs per cycle,
# re-downloadable from the portal. Parser fixtures are committed separately
# under backend/tests/fixtures/ohioFinance/.
scratch/ohio-campaign-finance/

# North Carolina NCSBE artifact cache (acquisition spike + sync runs),
# re-downloadable from the portal. Parser fixtures are committed separately
# under backend/tests/fixtures/northCarolinaFinance/.
scratch/north-carolina-campaign-finance/

# Georgia ethics-commission artifact cache (acquisition spike + sync runs),
# re-downloadable from the portals. Parser fixtures are committed separately
# under backend/tests/fixtures/georgiaFinance/.
scratch/georgia-campaign-finance/
scratch/montana-campaign-finance/

# Kansas SOS/KPDC artifact cache (scanned PDFs, viewer exports with
# contributor PII under K.S.A. 25-4154(d)) — never commit.
scratch/kansas-campaign-finance/
scratch/idaho-campaign-finance/

# Python bytecode. The roll-call audits are scripts, but one of them gets
# imported as a module when another script reuses its helpers, which writes a
# __pycache__ beside it — and a directory-wide `git add` then commits the .pyc.
__pycache__/
*.pyc

# Database dumps and ad-hoc backups. A 9 MB pg_dump
# (tmp_voteapp_backup_before_live_ai_20260511.sql) was tracked from
# 2026-05-12 to 2026-09-10; dumps carry request payloads and, once users
# exist, account rows. Never commit one.
tmp_*.sql
*.dump
*.pgdump

# Raw page captures from the records-verification sessions (governor +
# major-city mayor, 2026-09-05). They embed other sites' API keys and
# tracking tokens and trip every secrets scanner. The notes next to them
# (evidence.json, labels.json, records.json, *.md, stored.txt) stay tracked;
# the captures (src/ folders, HTML, PDF, XML, jina, bin) never do.
scratch/records-verify-*/**/src/
scratch/records-verify-*/**/*.html
scratch/records-verify-*/**/*.htm
scratch/records-verify-*/**/*.pdf
scratch/records-verify-*/**/*.xml
scratch/records-verify-*/**/*.jina
scratch/records-verify-*/**/*.bin
